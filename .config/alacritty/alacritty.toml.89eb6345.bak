[colors.cursor]
cursor = "0xFFFFFF"
text = "0x000000"

[terminal.shell]
args = [
  "-ic",
  "echo; fastfetch; exec bash"
]
program = "/usr/bin/bash"

[window]
opacity = 0.5

[font]
size = 11.0

[font.normal]
family = "UbuntuMono Nerd Font"
style = "Regular"


[[hints.enabled]]
regex = "[^ ]+\\.rs:\\d+:\\d+"

  [hints.enabled.command]
  program = "code"
  args = [ "--goto" ]

  [hints.enabled.mouse]
  enabled = true

[env]
TERM = "xterm-256color"

